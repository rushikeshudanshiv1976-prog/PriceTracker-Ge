# Copy to .env (never commit the real one).
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/price_tracker
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SERPAPI_KEY=
ENABLE_PRICE_SCHEDULER=true
PRICE_REFRESH_HOURS=12
REFRESH_ON_STARTUP=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
